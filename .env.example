# Variáveis conforme ADR-001 (docs/adr/001-stack.md).
# Nunca commitar .env com valores reais.

# --- Frontend (Vite) ---
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY=

# Base da API para o cliente gerado a partir do openapi.json
VITE_API_BASE_URL="https://<api>.vercel.app/v1"

# Sentry (front)
VITE_SENTRY_DSN=
